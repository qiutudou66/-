/* 全局样式 */
page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 颜色变量 */
.container {
  padding: 20rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 61, 0.06);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(90deg, #1890ff, #40a9ff);
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-danger {
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.btn-warn {
  background: #faad14;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.btn-default {
  background: #fff;
  color: #333;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
}

/* 表单 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.form-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 26rpx 28rpx;
  font-size: 30rpx;
}

/* 列表项 */
.list-item {
  background: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.tag-blue { background: #e6f7ff; color: #1890ff; }
.tag-green { background: #f6ffed; color: #52c41a; }
.tag-red { background: #fff1f0; color: #ff4d4f; }
.tag-orange { background: #fff7e6; color: #fa8c16; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

/* 价格 */
.price {
  color: #ff4d4f;
  font-weight: 600;
}

.price-small {
  color: #ff4d4f;
  font-size: 24rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.search-bar input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  background: #1890ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 60rpx;
  box-shadow: 0 4rpx 16rpx rgba(24,144,255,0.4);
  z-index: 100;
}

/* 汇总栏 */
.summary-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #eee;
}

.summary-item:last-child {
  border-right: none;
}

.summary-label {
  font-size: 22rpx;
  color: #999;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 4rpx;
}
