/* pages/sell/sell.wxss - 卖出确认 */
.detail-name {
  font-size: 34rpx;
  font-weight: 600;
}

.detail-sub {
  font-size: 26rpx;
  color: #999;
  margin: 8rpx 0 20rpx;
}

.cost-line {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.result-card {
  text-align: center;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #52c41a;
  margin-bottom: 20rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #666;
}

.profit-row {
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

button {
  margin-top: 16rpx;
}
