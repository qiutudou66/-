/* pages/stock/list/list.wxss - 库存列表 */
.status-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.status-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666;
}

.status-tab.active {
  color: #1890ff;
  font-weight: 600;
  border-bottom: 4rpx solid #1890ff;
}

.filter-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.filter-item {
  margin-right: 32rpx;
  font-size: 26rpx;
  color: #666;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.filter-item.active {
  color: #1890ff;
  background: #e6f7ff;
}

.stock-count {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.prod-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.prod-name {
  font-size: 30rpx;
  font-weight: 600;
}

.prod-info {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.imei {
  font-size: 22rpx;
  color: #bbb;
}

.prod-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 24rpx;
}

.tag-gray {
  background: #f5f5f5;
  color: #999;
}

.row-btn {
  font-size: 24rpx;
  padding: 4rpx 24rpx;
  margin: 0;
  background: #fff1f0;
  color: #ff4d4f;
  border-radius: 8rpx;
  line-height: 1.6;
}

.row-btn::after {
  border: none;
}
