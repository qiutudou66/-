/* pages/stock/list/list.wxss - 库存列表 */
.status-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.status-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666;
}

.status-tab.active {
  color: #1890ff;
  font-weight: 600;
  border-bottom: 4rpx solid #1890ff;
}

.filter-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.filter-item {
  margin-right: 32rpx;
  font-size: 26rpx;
  color: #666;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.filter-item.active {
  color: #1890ff;
  background: #e6f7ff;
}

.count-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.stock-count {
  font-size: 24rpx;
  color: #999;
}

.manage-entry {
  font-size: 24rpx;
  color: #1890ff;
  padding: 4rpx 16rpx;
  border: 2rpx solid #1890ff;
  border-radius: 8rpx;
}

.manage-entry.active {
  color: #999;
  border-color: #d9d9d9;
}

/* 管理模式：卡片可勾选 */
.card-selectable {
  display: flex;
  align-items: flex-start;
}

.card-selectable.card-selected {
  border: 2rpx solid #1890ff;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  margin-left: 16rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.check-circle.checked {
  background: #1890ff;
  border-color: #1890ff;
}

.check-circle.disabled {
  background: #f5f5f5;
  border-color: #e0e0e0;
}

/* 批量删除底部操作栏 */
.manage-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 50;
}

.manage-count {
  font-size: 28rpx;
  color: #333;
}

.manage-delete {
  width: 240rpx;
  padding: 14rpx 0;
  line-height: 1.6;
}

.manage-delete[disabled] {
  background: #ccc;
  box-shadow: none;
}

.manage-mode {
  padding-bottom: 160rpx;
}

.prod-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.prod-name {
  font-size: 30rpx;
  font-weight: 600;
}

.prod-info {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.imei {
  font-size: 22rpx;
  color: #bbb;
}

.prod-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 24rpx;
}

.tag-gray {
  background: #f5f5f5;
  color: #999;
}

.row-btn {
  font-size: 24rpx;
  padding: 4rpx 24rpx;
  margin: 0;
  background: #fff1f0;
  color: #ff4d4f;
  border-radius: 8rpx;
  line-height: 1.6;
}

.row-btn::after {
  border: none;
}
