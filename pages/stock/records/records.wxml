<!-- pages/stock/records/records.wxml -->
<view class="container">
  <view class="card">
    <view class="prod-title">{{productName}}</view>
  </view>

  <block wx:if="{{list.length > 0}}">
    <view class="card" wx:for="{{list}}" wx:key="_id">
      <view class="rec-header">
        <text class="rec-no">{{item.record_no}}</text>
        <text class="tag {{item.type === 'in' || item.type === 'adjust_in' ? 'tag-green' : 'tag-red'}}">{{typeMap[item.type]}}</text>
      </view>
      <view class="rec-info">
        <text>变动: <text class="{{item.quantity >= 0 ? 'tag-green' : 'tag-red'}">{{item.quantity > 0 ? '+' : ''}}{{item.quantity}}</text></text>
        <text>余量: {{item.after_qty}}</text>
      </view>
      <view class="rec-footer">
        <text class="rec-date">{{item.created_at}}</text>
        <text class="rec-remark">{{item.remark}}</text>
      </view>
    </view>
  </block>
  <view class="empty" wx:else>暂无库存流水</view>
</view>
