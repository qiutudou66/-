/* pages/flow/list/list.wxss - 流水/收支统计 */
.view-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
}

.view-tab.active {
  color: #1890ff;
  font-weight: 600;
  border-bottom: 4rpx solid #1890ff;
}

.date-bar {
  margin-bottom: 16rpx;
}

.date-item {
  display: inline-block;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.money-row {
  display: flex;
}

.money-item {
  flex: 1;
  text-align: center;
}

.money-label {
  font-size: 22rpx;
  color: #999;
}

.money-value {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.income { color: #ff4d4f; }
.expense { color: #52c41a; }
.profit { color: #1890ff; }

.type-tabs {
  display: flex;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.type-tab {
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.type-tab.active {
  background: #e6f7ff;
  color: #1890ff;
}

.flow-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.flow-item:last-child {
  border-bottom: none;
}

.flow-title {
  font-size: 28rpx;
}

.flow-memory {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.flow-meta {
  margin-top: 6rpx;
}

.flow-date {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

.flow-amount {
  font-size: 28rpx;
  font-weight: 600;
}
