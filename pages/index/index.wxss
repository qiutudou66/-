/* pages/index/index.wxss - 首页看板 */
.banner {
  background: linear-gradient(135deg, #1f2d3d, #2c4a6b);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.banner-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.banner-date {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.money-row {
  display: flex;
  padding: 12rpx 0;
}

.border-top {
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.money-item {
  flex: 1;
  text-align: center;
}

.money-label {
  font-size: 22rpx;
  color: #999;
}

.money-value {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.income { color: #ff4d4f; }
.expense { color: #52c41a; }
.profit { color: #1890ff; }

.action-card {
  padding: 24rpx;
}

.action-hint {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.section-more {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.flow-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.flow-item:last-child {
  border-bottom: none;
}

.flow-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.flow-memory {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.flow-right {
  text-align: right;
}

.flow-amount {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.flow-date {
  font-size: 22rpx;
  color: #999;
}
