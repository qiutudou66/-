/* pages/detail/detail.wxss - 手机详情 */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 3000px;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-name {
  font-size: 34rpx;
  font-weight: 600;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
  font-size: 28rpx;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  color: #999;
  flex-shrink: 0;
}

.detail-text {
  text-align: right;
}

.img-list {
  display: flex;
  flex-wrap: wrap;
}

.img-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.detail-imei {
  color: #999;
  font-size: 26rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.flow-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.flow-item:last-child {
  border-bottom: none;
}

.flow-date {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}

.flow-amount {
  font-size: 28rpx;
  font-weight: 600;
}

.income { color: #ff4d4f; }
.expense { color: #52c41a; }

.action-bar {
  margin-top: 20rpx;
}

.action-margin {
  margin-top: 16rpx;
}
